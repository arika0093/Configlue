<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0;net48</TargetFrameworks>
    <!-- The .NET SDK infers a win-x86 RuntimeIdentifier for the .NET Framework executable
         target on Windows, but NuGet restore does not, which causes NETSDK1047 for
         net48/win-x86. Declaring the RID here keeps restore and build in agreement. -->
    <RuntimeIdentifiers Condition="'$(OS)' == 'Windows_NT'">win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <OutputType>Exe</OutputType>
    <EnableTUnitPolyfills>false</EnableTUnitPolyfills>
    <PolyArgumentExceptions>true</PolyArgumentExceptions>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' != 'true'">
    <PackageReference Include="StackExchange.Redis" Version="3.3.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="bunit" Version="2.11.3" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Using Include="System.Net.Http" />
    <PackageReference Include="Polyfill" Version="11.4.1" PrivateAssets="all" />
    <PackageReference
      Include="Microsoft.NETFramework.ReferenceAssemblies"
      Version="1.0.3"
      PrivateAssets="all"
    />
    <Compile Remove="Formats/ConfiglueSchemaMsBuildTests.cs" />
    <Compile Remove="Resources/PipelineFingerprintTests.cs" />
    <Compile Remove="Resources/PostgreSqlSourceTests.cs" />
    <Compile Remove="Resources/PostgreSqlSourceCacheLifecycleTests.cs" />
    <Compile Remove="Resources/PostgreSqlSourceResidencyLeaseTests.cs" />
    <Compile Remove="Resources/PostgreSqlSchemaGuardTests.cs" />
    <Compile Remove="State/StatePipelineTests.cs" />
    <Compile Remove="State/RuntimeLifetimeTests.cs" />
    <Compile Remove="Contracts/Transformers/TransformerRecoveryPolicyContractTests.cs" />
    <Compile Remove="Contracts/Fragments/SharedMutableCollectionCloneTests.cs" />
    <Compile Remove="Extensions/ObservableAdapterTests.cs" />
    <Compile Remove="ReactiveSupport/ReactiveFixtures.cs" />
    <Compile Remove="Blazor/**/*.cs" />
    <Compile Remove="ComponentModel/**/*.cs" />
    <Compile Remove="MessagePack/**/*.cs" />
    <Compile Remove="Integration/**/*.cs" />
    <Compile Remove="Hosting/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly;Configlue.Codecs;Configlue.Migrations;Configlue.Resources;Configlue.Sources;Configlue.Extensibility;Configlue.State;Configlue.Transformers" />
    <PackageReference Include="Polyfill" Version="11.4.1" PrivateAssets="all" />
    <Compile Remove="**/*.cs" />
    <Compile Include="Portable/**/*.cs" />
    <ProjectReference Include="../../src/basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../src/basic/Configlue.Core/Configlue.Core.csproj" />
    <ProjectReference Include="../../src/providers/Configlue.Provider.Json/Configlue.Provider.Json.csproj" />
    <ProjectReference
      Include="../../src/tools/Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' != 'true'">
    <ProjectReference Include="../../src/basic/Configlue/Configlue.csproj" />
    <ProjectReference Include="../../src/basic/Configlue.Core/Configlue.Core.csproj" />
    <ProjectReference Include="../../src/extensions/Configlue.Extensions.DI/Configlue.Extensions.DI.csproj" />
    <ProjectReference Include="../../src/extensions/Configlue.Extensions.MSOptions/Configlue.Extensions.MSOptions.csproj" />
    <ProjectReference
      Include="../../src/tools/Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="../../src/providers/Configlue.Provider.Json/Configlue.Provider.Json.csproj" />
    <ProjectReference Include="../../src/providers/Configlue.Provider.Xml/Configlue.Provider.Xml.csproj" />
    <ProjectReference Include="../../src/providers/Configlue.Provider.Yaml/Configlue.Provider.Yaml.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.Environment/Configlue.Source.Environment.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.CommandLine/Configlue.Source.CommandLine.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.S3/Configlue.Resource.S3.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.Etcd/Configlue.Resource.Etcd.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.AzureKeyVault/Configlue.Resource.AzureKeyVault.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.SecretsManager/Configlue.Resource.SecretsManager.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.AwsAppConfig/Configlue.Resource.AwsAppConfig.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.GoogleSecretManager/Configlue.Resource.GoogleSecretManager.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.Kubernetes/Configlue.Resource.Kubernetes.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.Http/Configlue.Source.Http.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.Consul/Configlue.Source.Consul.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.Ssm/Configlue.Source.Ssm.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.Redis/Configlue.Resource.Redis.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.Vault/Configlue.Resource.Vault.csproj" />
    <ProjectReference Include="../../src/resources/Configlue.Resource.AzureAppConfiguration/Configlue.Resource.AzureAppConfiguration.csproj" />
    <ProjectReference Include="../../src/basic/Configlue.Testing/Configlue.Testing.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <ProjectReference Include="../../src/extensions/Configlue.Extensions.R3/Configlue.Extensions.R3.csproj" />
    <ProjectReference Include="../../src/extensions/Configlue.Extensions.ComponentModel/Configlue.Extensions.ComponentModel.csproj" />
    <ProjectReference Include="../../src/hosting/Configlue.Hosting.AspNetCore/Configlue.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="../../src/hosting/Configlue.Hosting.Blazor/Configlue.Hosting.Blazor.csproj" />
    <ProjectReference Include="../../src/hosting/Configlue.Hosting.Avalonia/Configlue.Hosting.Avalonia.csproj" />
    <ProjectReference Include="../../src/hosting/Configlue.Hosting.Maui/Configlue.Hosting.Maui.csproj" />
    <ProjectReference Include="../../src/tools/Configlue.JsonSchema.MSBuild/Configlue.JsonSchema.MSBuild.csproj" />
    <ProjectReference Include="../Configlue.JsonSchema.MSBuild.Fixtures/Configlue.JsonSchema.MSBuild.Fixtures.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.PostgreSql/Configlue.Source.PostgreSql.csproj" />
    <ProjectReference Include="../../src/sources/Configlue.Source.PostgreSql.Migrations/Configlue.Source.PostgreSql.Migrations.csproj" />
    <ProjectReference Include="../../src/transformers/Configlue.Transformer.AES/Configlue.Transformer.AES.csproj" />
    <ProjectReference Include="../../src/providers/Configlue.Provider.MessagePack/Configlue.Provider.MessagePack.csproj" />
    <ProjectReference Include="../../src/transformers/Configlue.Transformer.Compression/Configlue.Transformer.Compression.csproj" />
    <Compile
      Include="../Hosting.Shared/DispatcherTestState.cs"
      Link="Hosting/DispatcherTestState.cs"
    />
  </ItemGroup>
</Project>
