<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>true</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Keep in sync with src/Directory.Build.props; override with -p:ConfiglueSystemCommandLineVersion=... . -->
    <ConfiglueSystemCommandLineVersion Condition="'$(ConfiglueSystemCommandLineVersion)' == ''"
      >2.0.12</ConfiglueSystemCommandLineVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true'">
    <!-- The native binary runs only JsonAot tests; the test harness has reflection-based cases. -->
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2104;IL3000;IL3050;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.66.27" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.Retry" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Configlue.Codecs" />
    <Using Include="Configlue.Migrations" />
    <Using Include="Configlue.Resources" />
    <Using Include="Configlue.Sources" />
    <Using Include="Configlue.Extensibility" />
    <Using Include="Configlue.State" />
    <Using Include="Configlue.Transformers" />
  </ItemGroup>
</Project>
