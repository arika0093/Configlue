<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>true</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ConfiglueNetStandard20 Condition="'$(TargetFramework)' == 'netstandard2.0'">true</ConfiglueNetStandard20>
    <ConfiglueNetStandard Condition="'$(ConfiglueNetStandard20)' == 'true' or '$(TargetFramework)' == 'netstandard2.1'"
      >true</ConfiglueNetStandard>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <PublishAot>true</PublishAot>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <!-- The native binary runs only JsonAot tests; the test harness has reflection-based cases. -->
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2104;IL3000;IL3050;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="TUnit"
      Version="1.66.27"
      Condition="'$(ConfiglueNetStandard)' != 'true'"
    />
    <PackageReference
      Include="Shouldly"
      Version="4.3.0"
      Condition="'$(ConfiglueNetStandard)' != 'true'"
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.Retry"
      Version="2.4.1"
      Condition="'$(ConfiglueNetStandard)' != 'true'"
    />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Codecs" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.Migrations" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.Resources" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.Sources" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.Extensibility" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.State" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
    <Using Include="Configlue.Transformers" Condition="'$(ConfiglueNetStandard)' != 'true' and '$(MSBuildProjectName)' != 'SparseFragments.Tests'" />
  </ItemGroup>
</Project>
