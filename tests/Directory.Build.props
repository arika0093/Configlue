<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>true</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ConfiglueNetStandard20 Condition="'$(TargetFramework)' == 'netstandard2.0'">true</ConfiglueNetStandard20>
    <ConfiglueNetStandard Condition="'$(ConfiglueNetStandard20)' == 'true' or '$(TargetFramework)' == 'netstandard2.1'"
      >true</ConfiglueNetStandard>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="TUnit"
      Version="1.66.27"
      Condition="'$(ConfiglueNetStandard)' != 'true'"
    />
    <PackageReference
      Include="Shouldly"
      Version="4.3.0"
      Condition="'$(ConfiglueNetStandard)' != 'true'"
    />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Codecs" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Migrations" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Resources" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Sources" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Extensibility" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.State" Condition="'$(ConfiglueNetStandard)' != 'true'" />
    <Using Include="Configlue.Transformers" Condition="'$(ConfiglueNetStandard)' != 'true'" />
  </ItemGroup>
</Project>
