<Project>
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>true</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ConfiglueNativeAot)' == 'true'">
    <!-- The native binary runs only JsonAot tests; the test harness has reflection-based cases. -->
    <NoWarn>$(NoWarn);IL2026;IL2070;IL2104;IL3000;IL3050;IL3053</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="TUnit"
      Version="1.66.27"
      Condition="'$(TargetFramework)' != 'netstandard2.0'"
    />
    <PackageReference
      Include="Shouldly"
      Version="4.3.0"
      Condition="'$(TargetFramework)' != 'netstandard2.0'"
    />
    <PackageReference
      Include="Microsoft.Testing.Extensions.Retry"
      Version="2.4.1"
      Condition="'$(TargetFramework)' != 'netstandard2.0'"
    />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Codecs" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Migrations" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Resources" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Sources" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Extensibility" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.State" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
    <Using Include="Configlue.Transformers" Condition="'$(TargetFramework)' != 'netstandard2.0'" />
  </ItemGroup>
</Project>
