<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>NativeAot.Supported.Consumer</AssemblyName>
    <RootNamespace>NativeAotSupportedConsumer</RootNamespace>
    <PublishAot>true</PublishAot>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Report every trim warning individually instead of the per-assembly IL2104
      summary so new trimming regressions fail this supported-consumer gate.
    -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!--
      Warning-clean supported NativeAOT surface (#208, #251): the JSON facade over
      source-generated metadata plus generated fragment converters, and the generated
      MessagePack fragment path over an explicit closed-world resolver/options object
      (ConfiglueMessagePackResolver.CreateClosedWorldOptions). This consumer
      intentionally carries no WarningsNotAsErrors allowlist. The release gate
      (assert-supported-aot-diagnostics.sh) permits only the two proven-unreachable
      upstream MessagePackSecurity comparer diagnostics; any other IL trim/AOT
      diagnostic fails publish. The broader reflection-capable MessagePack API stays
      available for non-AOT hosts but is never referenced from this project.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly;Configlue.Codecs;Configlue.Migrations;Configlue.Resources;Configlue.Sources;Configlue.Extensibility;Configlue.State;Configlue.Transformers" />
  </ItemGroup>

  <!-- Restores Configlue from a local NuGet feed when ConfigluePackageVersion is provided. -->
  <ItemGroup Condition="'$(ConfigluePackageVersion)' == ''">
    <ProjectReference Include="../../../../src/basic/Configlue/Configlue.csproj" />
    <ProjectReference Include="../../../../src/providers/Configlue.Provider.MessagePack/Configlue.Provider.MessagePack.csproj" />
    <ProjectReference
      Include="../../../../src/tools/Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfigluePackageVersion)' != ''">
    <PackageReference Include="Configlue" Version="$(ConfigluePackageVersion)" />
    <PackageReference
      Include="Configlue.Provider.MessagePack"
      Version="$(ConfigluePackageVersion)"
    />
  </ItemGroup>
</Project>
