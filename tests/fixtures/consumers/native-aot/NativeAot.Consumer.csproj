<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>NativeAot.Consumer</AssemblyName>
    <RootNamespace>NativeAotConsumer</RootNamespace>
    <PublishAot>true</PublishAot>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Report every trim warning individually instead of the per-assembly IL2104
      summary so new trimming regressions fail this supported-consumer gate.
    -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly;Configlue.Codecs;Configlue.Migrations;Configlue.Resources;Configlue.Sources;Configlue.Extensibility;Configlue.State;Configlue.Transformers" />
  </ItemGroup>

  <!-- Restores Configlue from a local NuGet feed when ConfigluePackageVersion is provided. -->
  <ItemGroup Condition="'$(ConfigluePackageVersion)' == ''">
    <ProjectReference Include="../../../../src/basic/Configlue/Configlue.csproj" />
    <ProjectReference Include="../../../../src/providers/Configlue.Provider.MessagePack/Configlue.Provider.MessagePack.csproj" />
    <ProjectReference
      Include="../../../../src/tools/Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfigluePackageVersion)' != ''">
    <PackageReference Include="Configlue" Version="$(ConfigluePackageVersion)" />
    <PackageReference
      Include="Configlue.Provider.MessagePack"
      Version="$(ConfigluePackageVersion)"
    />
  </ItemGroup>

  <!--
    This narrowly scoped ILC allowance covers only upstream MessagePack 3.1.10
    diagnostics. Its dynamic/contractless resolver fallback (DynamicObjectResolver,
    DynamicUnionResolver, AttributeFormatterResolver, DynamicGenericResolver and
    BuiltinResolver helpers, ImmutableCollection helpers, ObjectSerializationInfo and
    DynamicObjectTypeBuilder emit paths, FormatterResolverExtensions.GetFormatterDynamic,
    MessagePackSerializer.CompiledMethods, MessagePackSerializerOptions.LoadType, and
    MessagePackSecurity.ObjectFallbackEqualityComparer) stays reachable through
    IFormatterResolver dispatch even for closed-world consumers. This consumer uses only
    generated formatters plus explicit leaf formatters and never invokes those fallbacks
    at runtime. Configlue's own codes (IL2026, IL2059) intentionally remain errors.
  -->
  <Target Name="AllowMessagePackFallbackAotDiagnostics" BeforeTargets="WriteIlcRspFileForCompilation">
    <PropertyGroup>
      <WarningsNotAsErrors>IL3050;IL2060;IL2055;IL2057;IL2066;IL2067;IL2070;IL2071;IL2072;IL2075;IL2080;IL2090;IL2091;IL2111</WarningsNotAsErrors>
    </PropertyGroup>
  </Target>
</Project>
