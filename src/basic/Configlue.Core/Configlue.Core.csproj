<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Core</AssemblyName>
    <RootNamespace>Configlue</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Dependency-injection-free configuration source resolution and runtime for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference
      Include="Microsoft.Bcl.TimeProvider"
      Version="8.0.0"
      Condition="'$(ConfiglueNetStandard)' == 'true'"
    />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.5" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference Include="System.IO.Pipelines" Version="10.0.0" />
    <PackageReference
      Include="System.ComponentModel.Annotations"
      Version="5.0.0"
      Condition="'$(ConfiglueNetStandard)' == 'true'"
    />
  </ItemGroup>
</Project>
