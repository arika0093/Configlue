<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue</AssemblyName>
    <RootNamespace>Configlue</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>The standard/default package for Configlue: ordinary local JSON, file, environment, common presets, and single-binary settings.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Configlue.Core/Configlue.Core.csproj" />
    <ProjectReference Include="../Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../providers/Configlue.Provider.Json/Configlue.Provider.Json.csproj" />
    <ProjectReference Include="../../sources/Configlue.Source.Environment/Configlue.Source.Environment.csproj" />
    <ProjectReference
      Include="../../tools/Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
    <PackageReference
      Include="System.Text.Json"
      Version="10.0.0"
      Condition="'$(ConfiglueNetStandard)' == 'true'"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../../tools/Configlue.Generator/bin/$(Configuration)/netstandard2.0/Configlue.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="build/Configlue.props" Pack="true" PackagePath="build/" Visible="false" />
  </ItemGroup>
</Project>
