<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Abstraction</AssemblyName>
    <RootNamespace>Configlue</RootNamespace>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);CONFIGLUE_FRAGMENT_RUNTIME</DefineConstants>
    <PackageDescription>Backend-neutral contracts for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard20)' == 'true'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
</Project>
