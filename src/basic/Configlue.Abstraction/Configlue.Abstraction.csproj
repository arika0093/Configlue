<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Abstraction</AssemblyName>
    <RootNamespace>Configlue</RootNamespace>
    <IsPackable>true</IsPackable>
    <DefineConstants>$(DefineConstants);CONFIGLUE_FRAGMENT_RUNTIME</DefineConstants>
    <PackageDescription>Backend-neutral contracts for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard20)' == 'true'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile
      Include="../../fragments/SparseFragments/SparseValueComparer.cs"
      Link="Fragments/ConfiglueValueComparer.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/FragmentComparisonPrimitives.cs"
      Link="Fragments/ConfiglueComparisonPrimitives.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/SparseCollectionMerger.cs"
      Link="Fragments/ConfiglueCollectionMerger.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/SparseCollectionRebase.cs"
      Link="Fragments/ConfiglueCollectionRebase.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/SparseModelRebase.cs"
      Link="Fragments/ConfiglueModelRebase.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/CollectionProvenance.cs"
      Link="Fragments/CollectionProvenance.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPatchDocument.cs"
      Link="Fragments/ConfiglueJsonPatchDocument.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPatchEngine.cs"
      Link="Fragments/ConfiglueJsonPatchEngine.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPatchOperation.cs"
      Link="Fragments/ConfiglueJsonPatchOperation.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPointer.cs"
      Link="Fragments/ConfiglueJsonPointer.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPatchException.cs"
      Link="Fragments/ConfiglueJsonPatchException.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/JsonPatchErrorKind.cs"
      Link="Fragments/ConfiglueJsonPatchErrorKind.cs"
    />
    <Compile
      Include="../../fragments/SparseFragments/SparseJsonPatch.cs"
      Link="Fragments/ConfiglueJsonPatch.cs"
    />
  </ItemGroup>
</Project>
