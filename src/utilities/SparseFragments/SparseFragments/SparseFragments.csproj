<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>SparseFragments</AssemblyName>
    <RootNamespace>SparseFragments</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Standalone sparse-fragment model algebra extracted from Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard20)' == 'true'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
</Project>
