<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>SparseFragments</AssemblyName>
    <RootNamespace>SparseFragments</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageDescription>Source-generated presence-aware sparse model fragments, diffs, and merge operations.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**/*.cs" />
    <ProjectReference Include="../SparseFragments.Abstractions/SparseFragments.Abstractions.csproj" />
    <ProjectReference
      Include="../SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseFragments.Generator/bin/$(Configuration)/netstandard2.0/SparseFragments.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
