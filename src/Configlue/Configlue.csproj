<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Configlue</AssemblyName>
    <RootNamespace>Configlue</RootNamespace>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageDescription>Convenience package for Configlue.</PackageDescription>
    <!-- This package intentionally contains dependencies and an analyzer but no lib assembly. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Configlue.Core/Configlue.Core.csproj" />
    <ProjectReference Include="../Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../Configlue.Extensions.DI/Configlue.Extensions.DI.csproj" />
    <ProjectReference Include="../Configlue.Provider.Json/Configlue.Provider.Json.csproj" />
    <ProjectReference Include="../Configlue.JsonSchema/Configlue.JsonSchema.csproj" />
    <ProjectReference Include="../Configlue.Resource.Http/Configlue.Resource.Http.csproj" />
    <ProjectReference Include="../Configlue.Source.Environment/Configlue.Source.Environment.csproj" />
    <ProjectReference Include="../Configlue.Source.Common/Configlue.Source.Common.csproj" />
    <ProjectReference
      Include="../Configlue.Generator/Configlue.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../Configlue.Generator/bin/$(Configuration)/netstandard2.0/Configlue.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
