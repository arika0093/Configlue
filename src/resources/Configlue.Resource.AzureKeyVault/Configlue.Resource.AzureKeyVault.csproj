<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Resource.AzureKeyVault</AssemblyName>
    <RootNamespace>Configlue.Resource.AzureKeyVault</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Azure Key Vault secrets resources for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../basic/Configlue.Core/Configlue.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Configlue.Tests" />
    <InternalsVisibleTo Include="Configlue.Benchmarks" />
  </ItemGroup>
</Project>
