<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Configlue.Source.CommandLine</AssemblyName>
    <RootNamespace>Configlue.Source.CommandLine</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>System.CommandLine parse-result source and opt-in common preset integration for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Configlue.Extensibility/Configlue.Extensibility.csproj" />
    <ProjectReference Include="../Configlue.Source.Presets/Configlue.Source.Presets.csproj" />
    <PackageReference Include="System.CommandLine" Version="$(ConfiglueSystemCommandLineVersion)" />
  </ItemGroup>
</Project>
