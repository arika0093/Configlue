<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseFragments</AssemblyName>
    <RootNamespace>SparseFragments</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Standalone sparse-fragment model algebra extracted from Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseFragments.Generator/bin/$(Configuration)/netstandard2.0/SparseFragments.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
  </ItemGroup>
</Project>
