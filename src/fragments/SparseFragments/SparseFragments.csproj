<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseFragments</AssemblyName>
    <RootNamespace>SparseFragments</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Typed partial state for C#. Distinguish missing, null, and values with source-generated fragments from ordinary POCOs, then merge, diff, and patch without reflection.</PackageDescription>
    <PackageTags>partial-update;optional;patch;diff;merge;source-generator;poco;json-patch;aot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseFragments.Generator/bin/$(Configuration)/netstandard2.0/SparseFragments.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="../SparseFragments.Generator/build/SparseFragments.props"
      Pack="true"
      PackagePath="build/SparseFragments.props"
      Visible="false"
    />
  </ItemGroup>
</Project>
