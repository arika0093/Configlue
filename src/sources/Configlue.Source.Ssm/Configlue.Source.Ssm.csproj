<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Source.Ssm</AssemblyName>
    <RootNamespace>Configlue.Source.Ssm</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>AWS SSM Parameter Store hierarchy source for Configlue.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.104.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../basic/Configlue.Core/Configlue.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ConfiglueNetStandard)' == 'true'">
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Configlue.Tests" />
    <InternalsVisibleTo Include="Configlue.Benchmarks" />
  </ItemGroup>
</Project>
