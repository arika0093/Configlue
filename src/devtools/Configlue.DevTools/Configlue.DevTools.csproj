<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.DevTools</AssemblyName>
    <RootNamespace>Configlue.DevTools</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Development-only host-neutral projections for Configlue DevTools. Optional; never reference from production graphs.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../basic/Configlue.Core/Configlue.Core.csproj" />
    <PackageReference
      Include="System.Text.Json"
      Version="10.0.0"
      Condition="'$(ConfiglueNetStandard)' == 'true'"
    />
  </ItemGroup>
</Project>
