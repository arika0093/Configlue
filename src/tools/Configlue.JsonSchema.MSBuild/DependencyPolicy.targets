<Project>
  <UsingTask
    TaskName="ValidateConfiglueJsonSchemaLockFile"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <LockFilePath ParameterType="System.String" Required="true" />
      <ExpectedVersions ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        if (File.Exists(LockFilePath))
        {
            var text = File.ReadAllText(LockFilePath);
            foreach (var item in ExpectedVersions)
            {
                var id = item.ItemSpec;
                var expected = item.GetMetadata("Version");
                var pattern = "\"" + Regex.Escape(id) + "\"\\s*:\\s*\\{[^}]*?\"resolved\"\\s*:\\s*\"([^\"]+)\"";
                var match = Regex.Match(text, pattern);
                if (!match.Success)
                {
                    Log.LogError(
                        "Configlue.JsonSchema.MSBuild: packages.lock.json has no resolved entry for the approved dependency '{0}' (expected {1}). Update packages.lock.json and the approved-version policy together.",
                        id,
                        expected);
                }
                else if (match.Groups[1].Value != expected)
                {
                    Log.LogError(
                        "Configlue.JsonSchema.MSBuild: resolved {0} version '{1}' does not match the approved version '{2}'. Change the allowed-version policy explicitly to cross this dependency boundary.",
                        id,
                        match.Groups[1].Value,
                        expected);
                }
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateConfiglueJsonSchemaDependencyPolicy" BeforeTargets="Restore;Build">
    <Error
      Condition="'$(JsonSchemaNetVersion)' != '$(AllowedJsonSchemaNetVersion)'"
      Text="Configlue.JsonSchema.MSBuild: JsonSchema.Net reference '$(JsonSchemaNetVersion)' does not match the approved version '$(AllowedJsonSchemaNetVersion)'. Update the approved-version policy explicitly to change this boundary."
    />
    <Error
      Condition="'$(JsonSchemaNetGenerationVersion)' != '$(AllowedJsonSchemaNetGenerationVersion)'"
      Text="Configlue.JsonSchema.MSBuild: JsonSchema.Net.Generation reference '$(JsonSchemaNetGenerationVersion)' does not match the approved version '$(AllowedJsonSchemaNetGenerationVersion)'. Update the approved-version policy explicitly to change this boundary."
    />
    <Error
      Condition="'$(JsonSchemaNetDataAnnotationsVersion)' != '$(AllowedJsonSchemaNetDataAnnotationsVersion)'"
      Text="Configlue.JsonSchema.MSBuild: JsonSchema.Net.Generation.DataAnnotations reference '$(JsonSchemaNetDataAnnotationsVersion)' does not match the approved version '$(AllowedJsonSchemaNetDataAnnotationsVersion)'. Update the approved-version policy explicitly to change this boundary."
    />
    <ValidateConfiglueJsonSchemaLockFile
      LockFilePath="$(MSBuildThisFileDirectory)packages.lock.json"
      ExpectedVersions="@(ConfiglueJsonSchemaApprovedDependency)"
    />
  </Target>
</Project>
