<Project>
  <!--
    Actual referenced versions. Automated dependency-update tooling is expected to
    change these values (and packages.lock.json).
  -->
  <PropertyGroup>
    <JsonSchemaNetVersion>8.0.4</JsonSchemaNetVersion>
    <JsonSchemaNetGenerationVersion>6.0.0</JsonSchemaNetGenerationVersion>
    <JsonSchemaNetDataAnnotationsVersion>2.0.0</JsonSchemaNetDataAnnotationsVersion>
  </PropertyGroup>

  <!--
    Approved pre-OSMF dependency policy. These values are intentionally separate from
    the actual referenced versions so a pull request that only bumps a package
    reference fails the dependency-policy validation target below.
  -->
  <PropertyGroup>
    <AllowedJsonSchemaNetVersion>8.0.4</AllowedJsonSchemaNetVersion>
    <AllowedJsonSchemaNetGenerationVersion>6.0.0</AllowedJsonSchemaNetGenerationVersion>
    <AllowedJsonSchemaNetDataAnnotationsVersion>2.0.0</AllowedJsonSchemaNetDataAnnotationsVersion>
    <AllowedJsonPointerNetVersion>6.0.1</AllowedJsonPointerNetVersion>
    <AllowedJsonMoreNetVersion>2.2.0</AllowedJsonMoreNetVersion>
    <AllowedHumanizerCoreVersion>3.0.1</AllowedHumanizerCoreVersion>
    <AllowedSystemComponentModelAnnotationsVersion>5.0.0</AllowedSystemComponentModelAnnotationsVersion>
  </PropertyGroup>

  <!--
    Resolved transitive versions that must match the approved policy in packages.lock.json.
  -->
  <ItemGroup>
    <ConfiglueJsonSchemaApprovedDependency
      Include="JsonSchema.Net"
      Version="$(AllowedJsonSchemaNetVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="JsonSchema.Net.Generation"
      Version="$(AllowedJsonSchemaNetGenerationVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="JsonSchema.Net.Generation.DataAnnotations"
      Version="$(AllowedJsonSchemaNetDataAnnotationsVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="JsonPointer.Net"
      Version="$(AllowedJsonPointerNetVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="Json.More.Net"
      Version="$(AllowedJsonMoreNetVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="Humanizer.Core"
      Version="$(AllowedHumanizerCoreVersion)"
    />
    <ConfiglueJsonSchemaApprovedDependency
      Include="System.ComponentModel.Annotations"
      Version="$(AllowedSystemComponentModelAnnotationsVersion)"
    />
  </ItemGroup>
</Project>
