<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dependency policy: exact PackageReference versions below are the single
    source of truth, pinned to the approved pre-OSMF JsonSchema.Net stack.
    Reproducibility comes from the checked-in packages.lock.json (locked
    restore). Dependabot ignore rules in .github/dependabot.yml keep automated
    updates off this family; any version change is therefore an explicit human
    decision reviewed like any other dependency bump.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Configlue.JsonSchema.MSBuild</AssemblyName>
    <RootNamespace>Configlue.JsonSchema.MSBuild</RootNamespace>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageDescription>Build-time JSON Schema generation for Configlue models.</PackageDescription>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      Locked restore pins the dependency graph for the default RID-less
      restore. Runtime-specific restores (RuntimeIdentifier/RuntimeIdentifiers)
      regenerate the lock file with RID-specific sections, so point them at a
      throwaway obj lock instead of the checked-in RID-less packages.lock.json.
    -->
    <RestorePackagesWithLockFile
      Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''"
      >true</RestorePackagesWithLockFile>
    <RestoreLockedMode
      Condition="'$(RestoreLockedMode)' == '' and '$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''"
      >true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != '' or '$(RuntimeIdentifiers)' != ''"
      >$(BaseIntermediateOutputPath)packages.runtime.lock.json</NuGetLockFilePath>
    <!-- MSBuild task assemblies belong under tasks/net10.0, not the runtime lib directory. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Build.Utilities.Core"
      Version="17.14.28"
      PrivateAssets="all"
      ExcludeAssets="runtime"
    />
    <PackageReference Include="JsonSchema.Net" Version="8.0.4" />
    <PackageReference Include="JsonSchema.Net.Generation" Version="6.0.0" />
    <PackageReference Include="JsonSchema.Net.Generation.DataAnnotations" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="build/Configlue.JsonSchema.MSBuild.props"
      Pack="true"
      PackagePath="build/"
      Visible="false"
    />
    <None
      Include="build/Configlue.JsonSchema.MSBuild.targets"
      Pack="true"
      PackagePath="build/"
      Visible="false"
    />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);ConfigluePackTaskAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="ConfigluePackTaskAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile
        Include="$(TargetDir)*.dll"
        Exclude="$(TargetDir)CSharpier.MsBuild.dll;$(TargetDir)SonarAnalyzer*.dll"
      >
        <PackagePath>tasks/net10.0/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
