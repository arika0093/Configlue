@namespace Configlue.Hosting.Blazor
@typeparam T

@if (_session is not null && _editContext is not null)
{
    @if (ChildContent is not null)
    {
        @ChildContent(_context)
    }
}
else if (IsLoading)
{
    @LoadingContent
}
else if (LoadFailure is not null && LoadFailedContent is not null)
{
    @LoadFailedContent(LoadFailure)
}
