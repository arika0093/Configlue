<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
    <AssemblyName>Configlue.Provider.Xml</AssemblyName>
    <RootNamespace>Configlue.Provider.Xml</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>XML codec for Configlue resources.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="System.Reflection.Emit"
      Version="4.7.0"
      Condition="'$(TargetFramework)' == 'netstandard2.0'"
    />
    <InternalsVisibleTo Include="Configlue.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../basic/Configlue.Core/Configlue.Core.csproj" />
    <ProjectReference Include="../../basic/Configlue/Configlue.csproj" />
  </ItemGroup>
</Project>
