@namespace Configlue.Extensions.Blazor
@typeparam T

@if (Snapshot is not null)
{
    @if (ChildContent is not null)
    {
        @ChildContent(_context)
    }
}
else if (IsLoading)
{
    @LoadingContent
}
else if (LoadFailure is not null && LoadFailedContent is not null)
{
    @LoadFailedContent(LoadFailure)
}
