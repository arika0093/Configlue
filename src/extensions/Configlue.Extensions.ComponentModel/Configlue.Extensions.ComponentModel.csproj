  <ItemGroup>
    <ProjectReference Include="../../basic/Configlue.Abstraction/Configlue.Abstraction.csproj" />
    <ProjectReference Include="../../basic/Configlue.Core/Configlue.Core.csproj" />
  </ItemGroup>
</Project>
