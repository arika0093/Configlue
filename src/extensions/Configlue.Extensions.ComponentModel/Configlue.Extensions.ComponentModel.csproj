    <AssemblyName>Configlue.Extensions.ComponentModel</AssemblyName>
    <RootNamespace>Configlue.Extensions.ComponentModel</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Host-neutral ComponentModel binding adapters for Configlue: INotifyPropertyChanged/INotifyDataErrorInfo read and edit views over snapshots and edit sessions, with a UI dispatch abstraction.</PackageDescription>
